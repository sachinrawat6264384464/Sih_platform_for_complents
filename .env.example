# AICTE Nexus - Environment Configuration Example
# Copy to .env in backend directory and adjust as required.

# Server & Runtime
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
PROJECT_NAME="AICTE NEXUS - Intelligent Institution Complaint Monitoring & Coordination Platform"

# Security & Tokens (Generate secure secret: openssl rand -hex 32)
SECRET_KEY=aicte_nexus_super_secret_development_key_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local PostgreSQL Database
# Note: Local Postgres is running on port 5433 with user postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicte_nexus
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/aicte_nexus
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aicte_nexus

# Redis Cache & Event Broker
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=25

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI & RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
HYBRID_BM25_WEIGHT=0.4
HYBRID_VECTOR_WEIGHT=0.6
OVERLAP_SIMILARITY_THRESHOLD=0.75
CONFIRMED_OVERLAP_THRESHOLD=0.88

